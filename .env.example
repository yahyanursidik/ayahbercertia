# Opsional. Tanpa key, `npm run sync` memakai feed RSS publik channel (maks. 15 video terbaru, tanpa durasi).
# Dengan key YouTube Data API v3: semua video, durasi, dan status embed. Di GitHub, simpan sebagai secret YOUTUBE_API_KEY.
YOUTUBE_API_KEY=

# Opsional: menimpa URL channel di src/data/youtube.config.json untuk tombol YouTube.
PUBLIC_YOUTUBE_CHANNEL_URL=

# Isi 1 untuk meninjau desain dengan data contoh (src/data/videos.mock.json).
USE_MOCK_CATALOG=
