---
import type { Audience, Editorial } from '../lib/videos';

interface Props {
  editorial: Editorial;
  audience: Audience | null;
}

const { editorial, audience } = Astro.props;
const isChild = audience === 'child';
const box = 'rounded-2xl border border-[#e2e9df] bg-surface p-5 sm:p-6';
const heading = 'text-base font-extrabold text-deep';
---

<div class="grid gap-4">
  {editorial.learningGoals?.length ? (
    <section class={box}>
      <h2 class={heading}>Tujuan belajar</h2>
      <ul class="mt-2 list-disc space-y-1 pl-5 text-[15px] text-[#4f6058]">
        {editorial.learningGoals.map((g) => <li>{g}</li>)}
      </ul>
    </section>
  ) : null}

  {editorial.questions?.length ? (
    <section class={box}>
      <h2 class={heading}>{isChild ? 'Ajak anak berbincang' : 'Renungan untuk Ayah'}</h2>
      <ul class="mt-2 space-y-2 text-[15px] text-[#4f6058]">
        {editorial.questions.map((q) => <li class="border-l-3 border-amber pl-3">{q}</li>)}
      </ul>
    </section>
  ) : null}

  {editorial.activity ? (
    <section class={box}>
      <h2 class={heading}>{editorial.activity.title}</h2>
      <ol class="mt-2 list-decimal space-y-1 pl-5 text-[15px] text-[#4f6058]">
        {editorial.activity.steps.map((s) => <li>{s}</li>)}
      </ol>
      {editorial.activity.safetyNote && (
        <p class="mt-3 rounded-lg bg-[#fff9e9] px-3 py-2 text-sm text-[#7c6236]">{editorial.activity.safetyNote}</p>
      )}
    </section>
  ) : null}

  {editorial.sources?.length ? (
    <section class={box}>
      <h2 class={heading}>Sumber</h2>
      <ul class="mt-2 space-y-1 text-sm text-muted">
        {editorial.sources.map((s) => (
          <li>{s.url ? <a href={s.url} class="text-forest underline" rel="noopener" target="_blank">{s.label}</a> : s.label}</li>
        ))}
      </ul>
    </section>
  ) : null}
</div>
