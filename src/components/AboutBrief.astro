---
const principles = [
  { title: 'Ilmu yang dapat dipertanggungjawabkan', body: 'Dalil, hadis, dan fakta sains diperiksa sebelum dipublikasikan.' },
  { title: 'Anak yang aktif berpikir', body: 'Belajar lewat pengamatan, pertanyaan, dan kegiatan sederhana.' },
  { title: 'Ayah yang terus bertumbuh', body: 'Refleksi pengasuhan yang hangat dan aplikatif, tanpa mendiagnosis.' },
];
---

<div class="flex h-full flex-col rounded-[1.25rem] bg-deep p-6 text-[#e8f2e9] sm:p-8">
  <p class="eyebrow text-[#a9c4b5]">Tentang Ayah Bercerita</p>
  <h3 id="tentang-singkat" class="mt-3 text-2xl font-extrabold text-white">Video adalah awal percakapan, bukan tujuan akhir.</h3>
  <p class="mt-3 text-[#c9d8cf]">
    Tujuan kami bukan menambah waktu layar, melainkan membuka percakapan dan pengalaman nyata antara ayah dan anak.
  </p>
  <ul class="mt-6 grid gap-4">
    {principles.map((p) => (
      <li class="border-t border-white/12 pt-4">
        <p class="font-bold text-white">{p.title}</p>
        <p class="mt-0.5 text-sm text-[#c9d8cf]">{p.body}</p>
      </li>
    ))}
  </ul>
  <a href="/tentang" class="mt-auto inline-flex min-h-11 items-center gap-1.5 self-start pt-6 font-bold text-white hover:underline">
    Kenali kami lebih jauh
    <svg viewBox="0 0 20 20" class="size-4" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 10h12m-5-5 5 5-5 5" /></svg>
  </a>
</div>
