---
const paths = [
  {
    eyebrow: 'Untuk anak dan keluarga',
    title: 'Cerita untuk Kita',
    body: 'Pertanyaan kecil, kisah, sains, adab, dan aktivitas untuk ditonton lalu dilakukan bersama.',
    points: ['Tauhid & ibadah', 'Sains & alam', 'Adab & sosial-emosi'],
    href: '/cerita-anak',
    cta: 'Lihat cerita anak',
    tone: 'bg-sage-soft border-[#d6e7d5]',
    accent: 'text-forest',
    bar: 'bg-sage',
  },
  {
    eyebrow: 'Untuk para ayah',
    title: 'Catatan Ayah',
    body: 'Refleksi singkat tentang kehadiran ayah, komunikasi, emosi, dan pendidikan keluarga — praktis, bukan ceramah panjang.',
    points: ['Komunikasi & emosi', 'Disiplin responsif', 'Refleksi & pendidikan Islam'],
    href: '/catatan-ayah',
    cta: 'Lihat catatan ayah',
    tone: 'bg-slate-soft border-[#dde5eb]',
    accent: 'text-slate',
    bar: 'bg-slate',
  },
];
---

<div class="grid gap-5 md:grid-cols-2">
  {paths.map((p) => (
    <article class:list={['relative flex flex-col overflow-hidden rounded-[1.25rem] border p-6 sm:p-8', p.tone]}>
      <span class:list={['absolute inset-y-0 left-0 w-1.5', p.bar]} aria-hidden="true" />
      <p class:list={['eyebrow', p.accent]}>{p.eyebrow}</p>
      <h3 class="mt-3 text-2xl font-extrabold">{p.title}</h3>
      <p class="mt-3 max-w-md text-[#4f6058]">{p.body}</p>
      <ul class="mt-5 flex flex-wrap gap-2">
        {p.points.map((point) => (
          <li class="rounded-full border border-white/80 bg-white/70 px-3 py-1 text-xs font-semibold text-ink">{point}</li>
        ))}
      </ul>
      <a href={p.href} class:list={['mt-auto inline-flex min-h-11 pt-6 items-center gap-1.5 self-start font-extrabold hover:underline', p.accent]}>
        {p.cta}
        <svg viewBox="0 0 20 20" class="size-4" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 10h12m-5-5 5 5-5 5" /></svg>
      </a>
    </article>
  ))}
</div>
