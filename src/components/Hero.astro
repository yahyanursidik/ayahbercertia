---
import HeroIllustration from './HeroIllustration.astro';
---

<section class="border-b border-line/70 bg-cream" aria-labelledby="hero-title">
  <div class="container-site grid items-center gap-10 py-12 md:py-16 lg:grid-cols-[1.1fr_0.9fr] lg:gap-16 lg:py-20">
    <div>
      <p class="eyebrow">Rumah cerita keluarga</p>
      <h1 id="hero-title" class="mt-4 max-w-[14ch] text-[2.25rem] font-extrabold sm:text-5xl lg:text-[3.6rem]">
        Dari cerita kecil, tumbuh rasa ingin tahu.
      </h1>
      <p class="mt-5 max-w-xl text-[17px] leading-relaxed text-[#4c5f56] sm:text-lg">
        Mengenal Allah, memahami alam, belajar adab, dan bertumbuh bersama. Cerita singkat untuk anak dan catatan
        hangat bagi para ayah — sekitar satu menit, satu ide untuk dilakukan hari ini.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/cerita-anak" class="btn btn-primary">
          Jelajahi Cerita
          <svg viewBox="0 0 20 20" class="size-4" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 10h12m-5-5 5 5-5 5" /></svg>
        </a>
        <a href="/catatan-ayah" class="btn btn-secondary">Untuk Para Ayah</a>
      </div>
    </div>
    <HeroIllustration />
  </div>
</section>
