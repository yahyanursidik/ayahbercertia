---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Halaman tidak ditemukan">
  <section class="bg-cream">
    <div class="container-site flex min-h-[60vh] flex-col items-start justify-center py-16">
      <p class="eyebrow">404</p>
      <h1 class="mt-3 text-4xl font-extrabold sm:text-5xl">Halaman ini belum ada ceritanya.</h1>
      <p class="mt-4 max-w-xl text-lg text-[#4c5f56]">
        Tautan mungkin sudah berubah, atau halaman ini sedang disiapkan. Coba mulai lagi dari beranda.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/" class="btn btn-primary">Kembali ke beranda</a>
        <a href="/video" class="btn btn-secondary">Jelajahi video</a>
      </div>
    </div>
  </section>
</BaseLayout>
