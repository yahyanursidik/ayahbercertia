---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionHeading from '../components/SectionHeading.astro';
import AfterWatching from '../components/AfterWatching.astro';
import YouTubeCta from '../components/YouTubeCta.astro';

const tracks = [
  {
    eyebrow: 'Jalur 1',
    title: 'Cerita untuk Kita',
    body: 'Untuk anak dan keluarga: tauhid, ibadah, adab, kisah, sains dan alam, sosial-emosi, numerasi, serta aktivitas sederhana.',
    href: '/cerita-anak',
    tone: 'bg-sage-soft border-[#d6e7d5]',
    accent: 'text-forest',
  },
  {
    eyebrow: 'Jalur 2',
    title: 'Catatan Ayah',
    body: 'Untuk para ayah: perkembangan anak, komunikasi, disiplin responsif, pendidikan Islam, serta refleksi dan tazkiyatun nafs.',
    href: '/catatan-ayah',
    tone: 'bg-slate-soft border-[#dde5eb]',
    accent: 'text-slate',
  },
];

const principles = [
  { title: 'Dalil diperiksa', body: 'Ayat dan hadis yang dikutip diverifikasi sumber dan kesahihannya sebelum dipublikasikan.' },
  { title: 'Sains yang akurat', body: 'Penjelasan ilmiah disederhanakan untuk anak tanpa mengorbankan ketepatan.' },
  { title: 'Bahasa yang natural', body: 'Disampaikan dengan bahasa sehari-hari yang hangat, tidak menggurui.' },
  { title: 'Tidak mendiagnosis', body: 'Satu perilaku anak tidak dijadikan dasar label atau kesimpulan klinis.' },
  { title: 'Aktivitas yang aman', body: 'Kegiatan yang disarankan sederhana, aman, dan dilakukan dengan pendampingan.' },
  { title: 'Tidak mengarang konten', body: 'Pertanyaan dan aktivitas tambahan hanya tampil setelah disunting tim editorial.' },
];
---

<BaseLayout
  title="Tentang"
  description="Ayah Bercerita menghadirkan video edukasi singkat untuk anak dan refleksi praktis bagi ayah, dengan prinsip editorial agama dan sains yang dapat dipertanggungjawabkan."
>
  <PageHeader
    eyebrow="Tentang kami"
    title="Cerita yang mempertemukan ilmu dan kebersamaan."
    lede="Ayah Bercerita adalah rumah digital untuk video edukasi singkat. Cerita kecil, ilmu baru, kebersamaan yang bermakna — video adalah awal percakapan, bukan tujuan akhir pembelajaran."
  />

  <section class="section" aria-labelledby="dua-jalur">
    <div class="container-site">
      <SectionHeading id="dua-jalur" title="Dua jalur, satu keluarga" lede="Setiap video dibuat untuk salah satu dari dua jalur berikut." />
      <div class="grid gap-5 md:grid-cols-2">
        {tracks.map((t) => (
          <a href={t.href} class:list={['group rounded-[1.25rem] border p-6 transition-shadow hover:shadow-[0_8px_24px_rgb(24_62_53/0.08)] sm:p-8', t.tone]}>
            <p class:list={['eyebrow', t.accent]}>{t.eyebrow}</p>
            <h3 class="mt-2 text-2xl font-extrabold">{t.title}</h3>
            <p class="mt-3 text-[#4f6058]">{t.body}</p>
            <span class:list={['mt-5 inline-flex items-center gap-1.5 font-bold group-hover:underline', t.accent]}>
              Lihat {t.title}
              <svg viewBox="0 0 20 20" class="size-4" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 10h12m-5-5 5 5-5 5" /></svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-[#f8f8f3]" aria-labelledby="prinsip">
    <div class="container-site">
      <SectionHeading id="prinsip" title="Prinsip editorial" lede="Komitmen kami terhadap ketepatan isi agama dan sains." />
      <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {principles.map((p) => (
          <li class="rounded-2xl border border-[#e2e9df] bg-surface p-6">
            <p class="text-lg font-bold text-deep">{p.title}</p>
            <p class="mt-1.5 text-muted">{p.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="cara-memakai">
    <div class="container-site grid gap-10 lg:grid-cols-2 lg:items-start">
      <SectionHeading
        id="cara-memakai"
        title="Cara memakai video sebagai percakapan keluarga"
        lede="Tonton bersama, lalu berhenti sejenak. Biarkan anak bertanya dan bercerita dengan kata-katanya sendiri sebelum orang tua menjelaskan."
      />
      <AfterWatching />
    </div>
  </section>

  <YouTubeCta />
</BaseLayout>
